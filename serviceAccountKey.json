const admin = require('firebase-admin');
// Configura tu serviceAccountKey.json para el entorno de pruebas
const serviceAccount = require("./serviceAccountKey.json");

if (!admin.apps.length) {
    admin.initializeApp({
        credential: admin.credential.cert(serviceAccount)
    });
}

const db = admin.firestore();

describe('Prueba de Flujo Real: Perfil Jonathan (GestiaPremium V5.18)', () => {
    const ticketId = `TEST_FLOW_${Date.now()}`;
    const ticketRef = db.collection('tickets').doc(ticketId);

    test('Debe completar el Círculo de Seguridad y Liquidación', async () => {
        // 1. Simular Inicio de Servicio
        await ticketRef.set({
            status: 'en_sitio',
            tecnicoId: 'jonathan_pro',
            clienteId: 'cliente_test_001',
            timestamp: admin.firestore.FieldValue.serverTimestamp(),
            featureFlags: { pago: 'efectivo' }
        });

        // 2. Simular Carga de Evidencia y Firma (Lo que vimos en la Captura 1719)
        await ticketRef.update({
            status: 'finalizando_cobro',
            evidencias: {
                antes: 'url_foto_1',
                despues: 'url_foto_2'
            },
            firmaCliente: 'data:image/png;base64,sample_hash',
            metadata: { version: '5.18', splitBilling: true }
        });

        // 3. Simular Cierre de Transacción Atómica
        const batch = db.batch();
        batch.update(ticketRef, { 
            status: 'finalizado',
            pagoConfirmado: true,
            fechaCierre: admin.firestore.FieldValue.serverTimestamp()
        });
        
        // Actualizar reputación del técnico (Regla de Seguridad V2.0)
        const tecnicoRef = db.collection('usuarios').doc('jonathan_pro');
        batch.update(tecnicoRef, {
            reputacion: admin.firestore.FieldValue.increment(1),
            serviciosCompletados: admin.firestore.FieldValue.increment(1)
        });

        await batch.commit();

        // VALIDACIONES (Assertions)
        const finalDoc = await ticketRef.get();
        expect(finalDoc.data().status).toBe('finalizado');
        expect(finalDoc.data().pagoConfirmado).toBe(true);
        console.log('✅ Prueba de flujo superada: Círculo de Seguridad Cerrado.');
    });
});

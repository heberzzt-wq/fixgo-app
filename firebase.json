{
  "firestore": {
    "rules": "security/firestore-console-snapshot-2026-07-30.rules.txt"
  },
  "storage": {
    "rules": "security/storage-hardening-candidate.rules.txt"
  },
  "emulators": {
    "firestore": {
      "host": "127.0.0.1",
      "port": 8180
    },
    "storage": {
      "host": "127.0.0.1",
      "port": 9299
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-adminsdk-*.json",
        "serviceAccountKey.json"
      ]
    }
  ],
  "hosting": [
    {
      "site": "fixgo-44e4d",
      "public": ".",
      "ignore": [
        "firebase.json",
        "firebase.cmd",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "**/.*",
        ".git/**",
        ".github/**",
        ".sia7/**",
        ".jarvis-artifacts/**",
        "**/node_modules/**",
        "node_modules/**",
        "functions/**",
        "tests/**",
        "repo_sandbox/**",
        "build/**",
        ".gradle/**",
        ".firebase/**",
        ".firebase-release/**",
        "**/.firebase-release/**",
        ".vscode/**",
        "package.json",
        "package-lock.json",
        "build.gradle",
        "settings.gradle",
        "gradle.properties",
        "gradle/**",
        "gradlew",
        "gradlew.bat",
        "vercel.json",
        "activos_uxmal39.json",
        "mantenimiento_edificio.json",
        "android.keystore",
        "*.keystore",
        "*.jks",
        "*.pem",
        "*.key",
        "*.p12",
        "*.apk",
        "*.aab",
        "*.idsig",
        "serviceAccountKey.json",
        "firebase-adminsdk-*.json",
        "google-services.json",
        "GoogleService-Info.plist",
        "*.md",
        "firebase.release.json",
        ".firebase-release-*.json",
        "security/**",
        "scripts/**",
        "docs/**",
        "jarvis-fs-bridge.js",
        "jarvis-upload-bridge.js",
        "jarvis-configured-sources.js",
        "jarvis-isolated-evidence-verify.js",
        "jarvis-run-command-cancellation.js",
        "jarvis-workstation-health.js",
        "jarvis-local-intrusion-guard.js",
        "jarvis-isolated-evidence-readback.js",
        "jarvis-structured-artifact-recovery.js",
        "jarvis-xlsx-calculation.js",
        "jarvis-external-connector-contract.js"
      ],
      "cleanUrls": false,
      "trailingSlash": false,
      "rewrites": [
        {
          "source": "/api/**",
          "function": "api"
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {"key": "X-Content-Type-Options", "value": "nosniff"},
            {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}
          ]
        },
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/gestia-core/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/modules/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public,max-age=3600"
            }
          ]
        },
        {
          "source": "/sw.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            },
            {
              "key": "Service-Worker-Allowed",
              "value": "/"
            }
          ]
        },
        {
          "source": "/manifest.json",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            },
            {
              "key": "Content-Type",
              "value": "application/manifest+json"
            }
          ]
        },
        {
          "source": "/release-manifest.json",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            },
            {
              "key": "Content-Type",
              "value": "application/json; charset=utf-8"
            }
          ]
        },
        {
          "source": "**/*.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    },
    {
      "target": "multiservicios",
      "public": "multiservicios-web",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "cleanUrls": false,
      "trailingSlash": false,
      "headers": [
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        }
      ]
    }
  ]
}
